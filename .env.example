# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# External calls are blocked by design-ingest unless allowed; set to 1 only for runs you accept to pay for.
DESIGN_INGEST_ALLOW_EXTERNAL=
# Optional daily token cap enforced by design-ingest.
DESIGN_INGEST_TOKEN_BUDGET=
# Folder with the manufacturer PDFs (not in git).
OM_COPILOT_RAW_DIR=data/raw
